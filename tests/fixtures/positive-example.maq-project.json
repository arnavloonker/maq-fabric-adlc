{
  "$schema": "maq-project.schema.json",
  "schemaVersion": 1,
  "packageVersion": "REPLACE_WITH_PINNED_INTERNAL_RELEASE",
  "ado": {
    "organizationUrl": "https://dev.azure.com/REPLACE_ORG",
    "project": "REPLACE_PROJECT",
    "team": "REPLACE_TEAM",
    "repository": "REPLACE_REPOSITORY_ID",
    "targetBranch": "refs/heads/main",
    "storyType": "User Story",
    "taskType": "Task",
    "areaPath": "REPLACE_AREA_PATH",
    "iterationPath": "REPLACE_ITERATION_PATH",
    "readinessTag": "build-ready",
    "fields": {
      "title": "System.Title",
      "description": "System.Description",
      "acceptanceCriteria": "Microsoft.VSTS.Common.AcceptanceCriteria",
      "tags": "System.Tags"
    },
    "classificationTags": {
      "architecture": [
        "platform-architecture"
      ],
      "dataEngineering": [
        "data-engineering"
      ],
      "experiment": [
        "experiment"
      ]
    },
    "taskScoping": {
      "basis": "vertical-tracer-bullet",
      "slicingRule": "single-context-window-end-to-end",
      "granularityLoop": "quiz-one-at-a-time-until-approved",
      "conventionsFile": "docs\\engineering-standards.md"
    }
  },
  "fabric": {
    "coverage": "all-workloads-versioned-matrix",
    "devIsolation": {
      "strategy": "branch-workspace-or-shared-dev-prefix",
      "prefixTemplate": "{branch_slug}_"
    },
    "tdd": {
      "anchor": "approach-seam",
      "executionStyle": "minimal-fast-query-or-parameter-window"
    },
    "environments": [
      {
        "name": "DEV",
        "workspaceIds": [
          "REPLACE_DEV_WORKSPACE_GUID"
        ],
        "allowMutation": true
      },
      {
        "name": "UAT",
        "workspaceIds": [
          "REPLACE_UAT_WORKSPACE_GUID"
        ],
        "allowMutation": false
      },
      {
        "name": "PROD",
        "workspaceIds": [
          "REPLACE_PROD_WORKSPACE_GUID"
        ],
        "allowMutation": false
      }
    ],
    "queryLimits": {
      "maxReturnedRows": 250,
      "timeoutSeconds": 60,
      "requirePurpose": true,
      "persistSensitiveRows": false
    }
  },
  "context": {
    "referencesRoot": "references",
    "domainRoot": "domain",
    "scratchRoot": ".agent-tmp",
    "approachSection": "Technical approach",
    "domainOwners": {}
  },
  "standards": [
    "docs\\engineering-standards.md"
  ],
  "policy": {
    "externalWrites": "preview-and-approve-change-set",
    "existingSharedFiles": "preview-before-edit",
    "newReferences": "allow-nondestructive-create",
    "workItemClosure": "human-only",
    "automaticMerge": false,
    "automaticDeployment": false,
    "toolFlow": "preferred-order-safe-substitution"
  },
  "verification": {
    "contractOrigin": "drafted-in-approach-reused-in-verify",
    "seamTarget": "single-highest-level-reconciliation-and-measure",
    "reviewer": "separate-context-required",
    "publication": "approved-story-comment",
    "verdicts": [
      "passed",
      "failed",
      "blocked",
      "inconclusive"
    ]
  },
  "status": {
    "defaultScope": "signed-in-user",
    "defaultIteration": "configured-team-current",
    "relatedContext": "labeled-relevant-relations",
    "phaseField": null,
    "allowLabeledPhaseInference": true,
    "history": {
      "lookbackDays": 30,
      "maxEvents": 50,
      "includeLinkedPrBuildEvents": true
    },
    "completionPercentage": false,
    "persistence": "save-only-when-requested"
  },
  "bestPractices": {
    "storage": "central-package-only",
    "entryFormat": "links-grouped-by-artifact-type",
    "automaticScopedConsultation": true,
    "missingOptionalEntry": "continue-without-announcement",
    "maintenance": "approved-central-pr-or-proposed-patch",
    "automaticConsumerUpdate": false,
    "centralSource": {
      "organizationUrl": "https://dev.azure.com/REPLACE_CENTRAL_ORG",
      "project": "REPLACE_CENTRAL_PROJECT",
      "repository": "REPLACE_CENTRAL_PACKAGE_REPOSITORY_ID",
      "targetBranch": "refs/heads/main",
      "catalogPath": ".apm\\skills\\best-practices\\reference\\catalog.md"
    }
  }
}
